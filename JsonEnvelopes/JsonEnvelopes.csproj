<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--net10.0 uses the in-box System.Text.Json; everything older gets netstandard2.0-->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <!--Match the version in readme.md (two places) and the newest CHANGELOG.md heading-->
    <Version>3.0.0</Version>
    <!--The key is public on purpose (Microsoft's OSS guidance); never change it, or the assembly identity changes-->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>JsonEnvelopes.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>JsonEnvelopes</PackageId>
    <Title>JsonEnvelopes</Title>
    <Authors>Dane Vinson</Authors>
    <Description>Standardized messaging with System.Text.Json serialization. Targets .NET Standard 2.0 and .NET 10.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DaneVinson/JsonEnvelopes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DaneVinson/JsonEnvelopes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>json;serialization;messaging;envelope;system.text.json</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--GitHub Actions sets GITHUB_ACTIONS; local builds keep full paths for the debugger-->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--10.x is the only serviced branch; the floor stays at 10.0.0 so consumers choose the patch-->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

</Project>
