<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/01/nuspec.xsd">
  <metadata minClientVersion="5.0.0">
    <id>JsonEnvelopes</id>
    <!--Match value in JsonEnvelopes.csproj and readme.md-->
    <version>3.0.0</version>
    <title>JsonEnvelopes</title>
    <authors>Dane Vinson</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/DaneVinson/JsonEnvelopes</projectUrl>
    <description>Standardized messaging with System.Text.Json serialization. Targets .NET Standard 2.0.</description>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <!--Match the version declared in JsonEnvelopes.csproj-->
        <dependency id="System.Text.Json" version="6.0.10" />
      </group>
    </dependencies>  
  </metadata>
  <files>
      <file src="JsonEnvelopes\bin\Release\netstandard2.0\JsonEnvelopes.dll" target="lib\netstandard2.0\JsonEnvelopes.dll" />
  </files>
</package>